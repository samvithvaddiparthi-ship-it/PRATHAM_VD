# Bhashini credentials (app: pratham). Get these from the Bhashini Udyat dashboard.
# Copy this file to .env and fill in the real values. .env is gitignored.
BHASHINI_UDYAT_KEY=your_udyat_key_here
BHASHINI_INFERENCE_API_KEY=your_inference_api_key_here

# Optional: override the default public ASR pipeline id.
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Optional: server-side transcript post-processing (accuracy/readability lever).
# itn = spoken numbers -> digits; punctuation = restore punctuation.
# Default is "itn,punctuation". Set to empty to get the raw transcript.
# BHASHINI_POSTPROCESSORS=itn,punctuation
